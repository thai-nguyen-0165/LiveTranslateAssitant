# Gemini Live auto-detects the source language, translates continuously to
# Vietnamese, and thainp-tts reads the result locally.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
GEMINI_LIVE_TARGET_LANGUAGE=vi
GEMINI_LIVE_ECHO_TARGET_LANGUAGE=false

# Local thainp-tts v3 Turbo speech output.
TTS_MODEL_REPO=pnnbao-ump/VieNeu-TTS-v3-Turbo
TTS_CODEC_REPO=OpenMOSS-Team/MOSS-Audio-Tokenizer-Nano-ONNX
TTS_PRECISION=int8
FFMPEG_BIN=ffmpeg
TTS_VOICE="Anh Tú"
TTS_THREADS=0
TTS_SKIP_FILLERS=true
# Live mode can speak an unfinished translation after this many words.
TTS_MIN_WORDS=10
TTS_CHUNK_WORDS=10
TTS_MAX_CHARS=96
TTS_TEMPERATURE=0.68
TTS_TOP_K=20
TTS_TOP_P=0.90
